# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change-me-to-a-different-long-random-secret-min-32-chars
REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Redis (for cache + queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SMTP (email delivery)
# Generic SMTP — works with any provider (Gmail, Office365, SES, college mail server).
# Port 587 + SMTP_SECURE=false uses STARTTLS; port 465 + SMTP_SECURE=true uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=DBATU Result Analysis

# Frontend (used to build the accept-invite link that goes in the email)
FRONTEND_URL=http://localhost:3000

# Invites
# 168 hours = 7 days
INVITE_TOKEN_TTL_HOURS=168

# Storage (S3-compatible — Neon Storage / AWS S3 / Cloudflare R2 / MinIO)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=
# true for Neon Storage and MinIO (the bucket is part of the path);
# false for AWS S3 and Cloudflare R2 (the bucket is the host's first label).
AWS_S3_FORCE_PATH_STYLE=false
MAX_FILE_SIZE_BYTES=52428800

# Hugging Face (for OCR)
HF_API_TOKEN=your-huggingface-token
HF_MODEL_TABLE= microsoft/table-transformer-structure-recognition
HF_MODEL_TEXT= microsoft/trocr-base-handwritten

# GROQ (for reading a scheme PDF into structured courses)
# Optional. Without it the scheme is still enterable by hand — the AI is an
# accelerator, never a dependency. See docs/END_USER_GUIDE.md.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_TIMEOUT_MS=60000
GROQ_MAX_RETRIES=2
GROQ_MAX_INPUT_CHARS=200000
# The provider caps output tokens per minute per key. The reader asks for
# at most this many, so two calls fit inside one window.
GROQ_MAX_OUTPUT_TOKENS=450
GROQ_MAX_INPUT_CHARS_PER_CALL=1200
# The wait between calls, so two calls land inside one rolling minute.
GROQ_MIN_GAP_MS=31000
GROQ_GUARD_MIN_GAP_MS=2100

# Rate limiting
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=3
THROTTLE_MEDIUM_TTL=60000
THROTTLE_MEDIUM_LIMIT=100
THROTTLE_LONG_TTL=3600000
THROTTLE_LONG_LIMIT=1000
