generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & RBAC
// ============================================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  // Set when the account was created through an invitation. The invitee's
  // own password is chosen at accept time, so this is `false` for everyone
  // who arrives through an invite link — it is reserved for password resets.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  invitedById        String?   @map("invited_by_id")
  invitedAt          DateTime? @map("invited_at")

  // Relations
  userRoles               UserRole[]
  teacherSubjects         TeacherSubject[]         @relation("TeacherSubjects")
  classTeacherAssignments ClassTeacherAssignment[]
  studentProfile          Student?                 @relation("StudentUser")
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  uploadedJobs            UploadJob[]
  generatedReports        Report[]                 @relation("ReportGeneratedBy")
  notifications           Notification[]
  sentInvites             Invite[]                 @relation("InvitesSent")
  passwordResets          PasswordReset[]

  @@index([email])
  @@index([isActive])
  @@map("users")
}

/// A one-time password-reset request. Only the SHA-256 hash of the raw token
/// is stored, so a database leak does not yield usable reset links.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // SUPER_ADMIN, ADMIN, HOD, TEACHER, PRINCIPAL, STUDENT
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // students:read, marks:write, etc.
  resource    String // students, marks, reports, etc.
  action      String // read, write, delete, etc.
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  branchId  String?  @map("branch_id") // Optional branch scope (for HOD/Teacher)
  grantedBy String?  @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================================================
// ACADEMIC STRUCTURE
// ============================================================================

model Branch {
  id        String   @id @default(uuid())
  code      String   @unique // CS, ME, CE, EE
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  subjectOfferings        SubjectOffering[]
  examinations            Examination[]
  classTeacherAssignments ClassTeacherAssignment[]
  students                Student[]
  userRoles               UserRole[]
  invites                 Invite[]

  @@map("branches")
}

model Scheme {
  id            String   @id @default(uuid())
  name          String   @unique // SCHEME_2019, SCHEME_2022, SCHEME_2024
  description   String
  rules         Json // SchemeRules: passingPercentage, graceMarks, components
  isActive      Boolean  @default(true) @map("is_active")
  effectiveFrom DateTime @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")

  subjectOfferings        SubjectOffering[]
  examinations            Examination[]
  classTeacherAssignments ClassTeacherAssignment[]
  students                Student[]

  @@map("schemes")
}

/// The subject identity: one row per subject, independent of the branch,
/// semester, scheme or academic year it is taught in. A subject becomes
/// teachable through `SubjectOffering`, which records that assignment.
model Subject {
  id           String   @id @default(uuid())
  code         String   @unique // Subject code like CS301
  name         String
  credits      Int
  maxMarks     Int      @map("max_marks")
  passingMarks Int      @map("passing_marks")
  components   Json // [{type: 'CA1', maxMarks: 20}, ...]
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  offerings SubjectOffering[]

  @@map("subjects")
}

/// A subject's assignment to a class context (branch + semester + scheme).
/// This is the row marks and teacher allocations hang off.
model SubjectOffering {
  id             String   @id @default(uuid())
  subjectId      String   @map("subject_id")
  branchId       String   @map("branch_id")
  semester       Int
  schemeId       String   @map("scheme_id")
  year           Int // 1, 2, 3, 4
  academicYearId String?  @map("academic_year_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scheme       Scheme        @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  marks           Mark[]
  teacherSubjects TeacherSubject[]

  @@unique([subjectId, branchId, semester, schemeId])
  @@index([branchId, schemeId, semester])
  @@index([academicYearId])
  @@map("subject_offerings")
}

/// A scheduled examination for one class context. `status` tracks the result
/// lifecycle: PENDING -> PROCESSING -> PUBLISHED (or FAILED).
model Examination {
  id                String    @id @default(uuid())
  name              String
  branchId          String    @map("branch_id")
  semester          Int
  schemeId          String    @map("scheme_id")
  academicYearId    String    @map("academic_year_id")
  examDate          DateTime  @map("exam_date")
  resultPublishedAt DateTime? @map("result_published_at")
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scheme       Scheme       @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([branchId, semester, schemeId, academicYearId])
  @@index([academicYearId])
  @@map("examinations")
}

/// The single class teacher for a class context (branch + semester + scheme +
/// academic year). The unique constraint enforces at most one per class.
model ClassTeacherAssignment {
  id             String   @id @default(uuid())
  branchId       String   @map("branch_id")
  semester       Int
  schemeId       String   @map("scheme_id")
  academicYearId String   @map("academic_year_id")
  teacherId      String   @map("teacher_id")
  assignedBy     String?  @map("assigned_by")
  assignedAt     DateTime @default(now()) @map("assigned_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scheme       Scheme       @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([branchId, semester, schemeId, academicYearId])
  @@index([teacherId])
  @@index([academicYearId])
  @@map("class_teacher_assignments")
}

model TeacherSubject {
  id                String @id @default(uuid())
  teacherId         String @map("teacher_id")
  subjectOfferingId String @map("subject_offering_id")
  academicYearId    String @map("academic_year_id")

  teacher         User            @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])

  @@unique([teacherId, subjectOfferingId, academicYearId])
  @@index([teacherId])
  @@index([subjectOfferingId])
  @@map("teacher_subjects")
}

// ============================================================================
// STUDENTS & MARKS
// ============================================================================

model AcademicYear {
  id        String   @id @default(uuid())
  year      String   @unique // "2024-25"
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")

  batches                 Batch[]
  students                Student[]
  marks                   Mark[]
  teacherSubjects         TeacherSubject[]
  subjectOfferings        SubjectOffering[]
  examinations            Examination[]
  classTeacherAssignments ClassTeacherAssignment[]

  @@map("academic_years")
}

model Batch {
  id              String  @id @default(uuid())
  name            String // "2022-26"
  admissionYearId String  @map("admission_year_id")
  isActive        Boolean @default(true) @map("is_active")

  admissionYear AcademicYear @relation(fields: [admissionYearId], references: [id])
  students      Student[]

  @@map("batches")
}

model Student {
  id             String   @id @default(uuid())
  rollNo         String   @map("roll_no")
  name           String
  /// Optional login for this student. Provisioned by the examination cell.
  email          String?  @unique
  userId         String?  @unique @map("user_id")
  branchId       String   @map("branch_id")
  currentYear    Int      @map("current_year")
  semester       Int
  schemeId       String   @map("scheme_id")
  batchId        String   @map("batch_id")
  academicYearId String   @map("academic_year_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  branch       Branch       @relation(fields: [branchId], references: [id])
  scheme       Scheme       @relation(fields: [schemeId], references: [id])
  batch        Batch        @relation(fields: [batchId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  user         User?        @relation("StudentUser", fields: [userId], references: [id], onDelete: SetNull)
  marks        Mark[]

  @@unique([rollNo, academicYearId])
  @@index([rollNo])
  @@index([branchId, currentYear, semester])
  @@index([schemeId])
  @@map("students")
}

model Mark {
  id                String   @id @default(uuid())
  studentId         String   @map("student_id")
  subjectOfferingId String   @map("subject_offering_id")
  examType          String   @map("exam_type") // CA1, CA2, MID_SEM, WRITTEN, PRACTICAL, ORAL
  marksObtained     Float    @map("marks_obtained")
  maxMarks          Float    @map("max_marks")
  isAbsent          Boolean  @default(false) @map("is_absent")
  isWithheld        Boolean  @default(false) @map("is_withheld")
  academicYearId    String   @map("academic_year_id")
  remarks           String?
  createdBy         String?  @map("created_by")
  updatedBy         String?  @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, subjectOfferingId, examType, academicYearId])
  @@index([studentId])
  @@index([subjectOfferingId])
  @@map("marks")
}

// ============================================================================
// FILE PROCESSING & REPORTS
// ============================================================================

model UploadJob {
  id            String    @id @default(uuid())
  uploadedBy    String    @map("uploaded_by")
  fileName      String    @map("file_name")
  fileType      String    @map("file_type") // EXCEL, PDF_TEXT, PDF_IMAGE
  fileUrl       String    @map("file_url") // Storage URL
  fileSize      Int       @map("file_size")
  status        String    @default("PENDING") // PENDING, PROCESSING, EXTRACTED, FAILED, COMPLETED
  progress      Int       @default(0)
  errorMessage  String?   @map("error_message")
  extractedData Json?     @map("extracted_data")
  metadata      Json?
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  uploadedByUser User @relation(fields: [uploadedBy], references: [id])

  @@index([status, createdAt])
  @@index([uploadedBy])
  @@map("upload_jobs")
}

model Report {
  id           String    @id @default(uuid())
  generatedBy  String    @map("generated_by")
  type         String // STUDENT_WISE, SCHEME_WISE, SUBJECT_ANALYSIS, STUDENT_ANALYSIS, CLASS_TOPPERS, PASS_FAIL, COMPLETE
  filters      Json
  fileUrl      String?   @map("file_url")
  status       String    @default("PENDING")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  generatedByUser User @relation("ReportGeneratedBy", fields: [generatedBy], references: [id])

  @@index([generatedBy])
  @@index([status])
  @@map("reports")
}

// ============================================================================
// AUDIT & NOTIFICATIONS
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String // LOGIN, CREATE_USER, UPDATE_MARKS, etc.
  resource   String // user, marks, scheme
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String // UPLOAD_COMPLETE, REPORT_READY, etc.
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ============================================================================
// INVITES
// ============================================================================

/// Lifecycle of a member invitation.
enum InviteStatus {
  /// Sent, not yet accepted. The only status that can be accepted.
  PENDING
  /// The invitee accepted and an account now exists.
  ACCEPTED
  /// An administrator cancelled the invitation before it was accepted.
  REVOKED
  /// The expiry window elapsed. Flipped lazily when the invite is next read.
  EXPIRED
}

/// An invitation to join the system.
///
/// The user account does not exist until the invitation is accepted, so an
/// unaccepted invitation grants no access at all. Only the SHA-256 hash of the
/// token is stored — a database leak yields no usable invitation links.
model Invite {
  id          String       @id @default(uuid())
  email       String
  name        String
  roleName    String       @map("role_name")
  branchId    String?      @map("branch_id")
  /// SHA-256 of the raw token. The raw token exists only in the email link.
  tokenHash   String       @unique @map("token_hash")
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime     @map("expires_at")
  acceptedAt  DateTime?    @map("accepted_at")
  invitedById String       @map("invited_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  /// Set when a resend replaced this invitation. The link still exists but
  /// it is dead — the newer invitation is the live one. It is kept so the
  /// history stays readable and so a stale link is not mistaken for a live
  /// one.
  supersededById String? @map("superseded_by_id")

  invitedBy    User     @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supersededBy Invite?  @relation("InviteSuperseded", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Invite[] @relation("InviteSuperseded")

  @@index([email])
  @@index([status, expiresAt])
  @@index([invitedById])
  @@index([supersededById])
  @@map("invites")
}
