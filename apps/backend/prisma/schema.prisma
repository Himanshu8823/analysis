generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & RBAC
// ============================================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  // Set when the account was created through an invitation. The invitee's
  // own password is chosen at accept time, so this is `false` for everyone
  // who arrives through an invite link — it is reserved for password resets.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  invitedById        String?   @map("invited_by_id")
  invitedAt          DateTime? @map("invited_at")

  // The member's profile picture, stored in the object-storage bucket.
  // `null` means the member never picked one — the UI shows their initials.
  avatarUrl String? @map("avatar_url")

  // Relations
  userRoles               UserRole[]
  teacherSubjects         TeacherSubject[]         @relation("TeacherSubjects")
  classTeacherAssignments ClassTeacherAssignment[]
  studentProfile          Student?                 @relation("StudentUser")
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  uploadedJobs            UploadJob[]
  generatedReports        Report[]                 @relation("ReportGeneratedBy")
  notifications           Notification[]
  sentInvites             Invite[]                 @relation("InvitesSent")
  passwordResets          PasswordReset[]

  @@index([email])
  @@index([isActive])
  @@map("users")
}

/// A one-time password-reset request. Only the SHA-256 hash of the raw token
/// is stored, so a database leak does not yield usable reset links.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // SUPER_ADMIN, ADMIN, HOD, TEACHER, PRINCIPAL, STUDENT
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // students:read, marks:write, etc.
  resource    String // students, marks, reports, etc.
  action      String // read, write, delete, etc.
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  branchId  String?  @map("branch_id") // Optional branch scope (for HOD/Teacher)
  grantedBy String?  @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================================================
// ACADEMIC STRUCTURE
// ============================================================================

model Branch {
  id        String   @id @default(uuid())
  code      String   @unique // CS, ME, CE, EE
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  subjectOfferings        SubjectOffering[]
  examinations            Examination[]
  classTeacherAssignments ClassTeacherAssignment[]
  students                Student[]
  enrollments             StudentEnrollment[]
  userRoles               UserRole[]
  invites                 Invite[]

  @@map("branches")
}

model Scheme {
  id            String   @id @default(uuid())
  name          String   @unique // SCHEME_2019, SCHEME_2022, SCHEME_2024
  description   String
  rules         Json // SchemeRules: passingPercentage, graceMarks, components
  isActive      Boolean  @default(true) @map("is_active")
  effectiveFrom DateTime @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")

  subjectOfferings        SubjectOffering[]
  examinations            Examination[]
  classTeacherAssignments ClassTeacherAssignment[]
  students                Student[]
  enrollments             StudentEnrollment[]

  @@map("schemes")
}

/// The subject identity: one row per subject, independent of the branch,
/// semester, scheme or academic year it is taught in. A subject becomes
/// teachable through `SubjectOffering`, which records that assignment.
model Subject {
  id           String   @id @default(uuid())
  code         String   @unique // Subject code like CS301
  name         String
  credits      Int
  maxMarks     Int      @map("max_marks")
  passingMarks Int      @map("passing_marks")
  components   Json // [{type: 'CA1', maxMarks: 20}, ...]
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  offerings SubjectOffering[]

  @@map("subjects")
}

/// A subject's assignment to a class context (branch + semester + scheme).
/// This is the row marks and teacher allocations hang off.
///
/// The curriculum year is not stored: it is derived from the semester, so it
/// can never contradict it.
model SubjectOffering {
  id             String   @id @default(uuid())
  subjectId      String   @map("subject_id")
  branchId       String   @map("branch_id")
  semester       Int
  schemeId       String   @map("scheme_id")
  academicYearId String?  @map("academic_year_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scheme       Scheme        @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  marks           Mark[]
  teacherSubjects TeacherSubject[]

  @@unique([subjectId, branchId, semester, schemeId])
  @@index([branchId, schemeId, semester])
  @@index([academicYearId])
  @@map("subject_offerings")
}

/// A scheduled examination for one class context. `status` tracks the result
/// lifecycle: PENDING -> PROCESSING -> PUBLISHED (or FAILED).
model Examination {
  id                String    @id @default(uuid())
  name              String
  branchId          String    @map("branch_id")
  semester          Int
  schemeId          String    @map("scheme_id")
  academicYearId    String    @map("academic_year_id")
  examDate          DateTime  @map("exam_date")
  resultPublishedAt DateTime? @map("result_published_at")
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scheme       Scheme       @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([branchId, semester, schemeId, academicYearId])
  @@index([academicYearId])
  @@map("examinations")
}

/// The single class teacher for a class context (branch + semester + scheme +
/// academic year). The unique constraint enforces at most one per class.
model ClassTeacherAssignment {
  id             String   @id @default(uuid())
  branchId       String   @map("branch_id")
  semester       Int
  schemeId       String   @map("scheme_id")
  academicYearId String   @map("academic_year_id")
  teacherId      String   @map("teacher_id")
  assignedBy     String?  @map("assigned_by")
  assignedAt     DateTime @default(now()) @map("assigned_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scheme       Scheme       @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([branchId, semester, schemeId, academicYearId])
  @@index([teacherId])
  @@index([academicYearId])
  @@map("class_teacher_assignments")
}

model TeacherSubject {
  id                String @id @default(uuid())
  teacherId         String @map("teacher_id")
  subjectOfferingId String @map("subject_offering_id")
  academicYearId    String @map("academic_year_id")

  teacher         User            @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])

  @@unique([teacherId, subjectOfferingId, academicYearId])
  @@index([teacherId])
  @@index([subjectOfferingId])
  @@map("teacher_subjects")
}

// ============================================================================
// STUDENTS & MARKS
// ============================================================================

model AcademicYear {
  id        String   @id @default(uuid())
  year      String   @unique // "2024-25"
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")

  batches                 Batch[]
  students                Student[]
  enrollments             StudentEnrollment[]
  marks                   Mark[]
  teacherSubjects         TeacherSubject[]
  subjectOfferings        SubjectOffering[]
  examinations            Examination[]
  classTeacherAssignments ClassTeacherAssignment[]

  @@map("academic_years")
}

model Batch {
  id              String  @id @default(uuid())
  name            String // "2022-26"
  admissionYearId String  @map("admission_year_id")
  isActive        Boolean @default(true) @map("is_active")

  admissionYear AcademicYear @relation(fields: [admissionYearId], references: [id])
  students      Student[]

  @@map("batches")
}

/// Where a student stands in the course.
///
/// The lifecycle replaces the old flat `isActive` flag, which could only say
/// "in the system" or "not in the system" — it could not say whether a
/// student had finished the course, left it, or was away for a term. The
/// reason and the date travel with the status so a clerk can always answer
/// "why is this student not on the roster?" without digging.
enum StudentStatus {
  /// On the roll, studying.
  ACTIVE
  /// The course is complete — the student has passed the final semester.
  GRADUATED
  /// The student left before completing the course.
  DROPPED_OUT
  /// The student is temporarily away — a medical leave, a year abroad.
  ON_LEAVE
}

/// The student's gender, as the college records it.
enum Gender {
  MALE
  FEMALE
  OTHER
  /// The college has not recorded it — the default, so a record is never
  /// rejected for omitting a field the college does not yet hold.
  NOT_RECORDED
}

/// The blood group, as recorded on the college's identity card.
enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  /// Not recorded.
  NOT_RECORDED
}

/// The reservation category a student falls under.
///
/// The values are the ones an Indian college uses: the general category and
/// the reserved categories named in the statutes.
enum ReservedCategory {
  GENERAL
  SC
  ST
  OBC
  EWS
  /// Not recorded.
  NOT_RECORDED
}

/// The fee category a student is charged under.
enum FeeCategory {
  /// The regular fee.
  REGULAR
  /// The management quota seat.
  MANAGEMENT_QUOTA
  /// The NRI fee.
  NRI
  /// A fee concession granted by the college.
  CONCESSION
  /// A scholarship seat.
  SCHOLARSHIP
  /// Not recorded.
  NOT_RECORDED
}

/// How a guardian is related to the student.
enum GuardianRelation {
  FATHER
  MOTHER
  GRANDFATHER
  GRANDMOTHER
  UNCLE
  AUNT
  SPOUSE
  SIBLING
  /// The student has not recorded the relation.
  OTHER
}

model Student {
  id             String   @id @default(uuid())
  rollNo         String   @map("roll_no")
  name           String
  /// Optional login for this student. Provisioned by the examination cell.
  email          String?  @unique
  userId         String?  @unique @map("user_id")
  branchId       String   @map("branch_id")
  semester       Int
  schemeId       String   @map("scheme_id")
  batchId        String   @map("batch_id")
  academicYearId String   @map("academic_year_id")
  /// The admission year — the calendar year the student joined the course.
  admissionYear  Int?     @map("admission_year")
  /// The section (division) the student studies in, e.g. "A" or "B".
  section        String? @map("section")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  // -------------------------------------------------------------------------
  // Personal details
  // -------------------------------------------------------------------------

  /// Date of birth.
  dateOfBirth DateTime? @map("date_of_birth")
  gender      Gender?   @default(NOT_RECORDED) @map("gender")

  // -------------------------------------------------------------------------
  // Contact details
  // -------------------------------------------------------------------------

  /// The student's own mobile number.
  phone          String? @map("phone")
  /// A second address, for a student who has one.
  alternateEmail String? @map("alternate_email")
  address        String?
  city           String?
  state          String?
  pincode        String?

  // -------------------------------------------------------------------------
  // Identity details — SENSITIVE
  //
  // These are the fields the college keeps but does not show to everyone:
  // a teacher has no business reading a student's identity number, and the
  // Principal has no business reading it either. They are gated by the
  // profile service, not by the frontend hiding a column.
  // -------------------------------------------------------------------------

  /// The student's photograph, as a URL into the object-storage bucket.
  photoUrl   String?     @map("photo_url")
  bloodGroup BloodGroup? @default(NOT_RECORDED) @map("blood_group")
  /// The national identity reference (Aadhaar or equivalent).
  nationalId String?     @map("national_id")

  // -------------------------------------------------------------------------
  // Category and quotas
  // -------------------------------------------------------------------------

  reservedCategory ReservedCategory? @default(NOT_RECORDED) @map("reserved_category")
  feeCategory      FeeCategory?      @default(NOT_RECORDED) @map("fee_category")
  /// Whether the student holds a scholarship.
  scholarshipRecipient Boolean @default(false) @map("scholarship_recipient")

  // -------------------------------------------------------------------------
  // Guardians — one or both
  // -------------------------------------------------------------------------

  guardianName       String?           @map("guardian_name")
  guardianRelation   GuardianRelation? @map("guardian_relation")
  guardianPhone      String?           @map("guardian_phone")
  guardianEmail      String?           @map("guardian_email")
  guardianOccupation String?           @map("guardian_occupation")

  /// The second guardian — set when the college records both.
  guardian2Name       String?           @map("guardian2_name")
  guardian2Relation   GuardianRelation? @map("guardian2_relation")
  guardian2Phone      String?           @map("guardian2_phone")
  guardian2Email      String?           @map("guardian2_email")
  guardian2Occupation String?           @map("guardian2_occupation")

  // -------------------------------------------------------------------------
  // Status lifecycle
  // -------------------------------------------------------------------------

  /// Where the student stands in the course.
  status StudentStatus @default(ACTIVE) @map("status")
  /// Why the status was last changed — "medical leave", "completed the course".
  statusReason String? @map("status_reason")
  /// The day the status was last changed.
  statusDate   DateTime? @map("status_date")

  branch       Branch       @relation(fields: [branchId], references: [id])
  scheme       Scheme       @relation(fields: [schemeId], references: [id])
  batch        Batch        @relation(fields: [batchId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  user         User?        @relation("StudentUser", fields: [userId], references: [id], onDelete: SetNull)
  marks        Mark[]
  /// The student's per-semester enrolment history — §2.8.3.
  enrollments  StudentEnrollment[]

  @@unique([rollNo, academicYearId])
  @@index([rollNo])
  @@index([branchId, semester])
  @@index([schemeId])
  @@index([status])
  @@map("students")
}

/// One semester a student was enrolled in.
///
/// The `Student` row records where the student is *now*. This row records
/// where they *were* — so a Sem 5 student's Sem 1 marks, subjects and result
/// stay attached to the Sem 1 they were earned in, and the profile screen can
/// show the whole journey rather than only the current semester.
///
/// Without it, advancing a student meant overwriting `semester`, and the
/// earlier semester's subjects and result fell out of the picture entirely.
model StudentEnrollment {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  branchId       String   @map("branch_id")
  schemeId       String   @map("scheme_id")
  semester       Int
  academicYearId String   @map("academic_year_id")
  /// The section the student was in that semester.
  section        String? @map("section")
  /// Whether this is the semester the student is currently studying.
  isCurrent      Boolean  @default(false) @map("is_current")
  enrolledAt     DateTime @default(now()) @map("enrolled_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  scheme       Scheme       @relation(fields: [schemeId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, semester, academicYearId])
  @@index([studentId, academicYearId])
  @@index([studentId])
  @@map("student_enrollments")
}

model Mark {
  id                String   @id @default(uuid())
  studentId         String   @map("student_id")
  subjectOfferingId String   @map("subject_offering_id")
  examType          String   @map("exam_type") // CA1, CA2, MID_SEM, WRITTEN, PRACTICAL, ORAL
  marksObtained     Float    @map("marks_obtained")
  maxMarks          Float    @map("max_marks")
  isAbsent          Boolean  @default(false) @map("is_absent")
  isWithheld        Boolean  @default(false) @map("is_withheld")
  academicYearId    String   @map("academic_year_id")
  remarks           String?
  createdBy         String?  @map("created_by")
  updatedBy         String?  @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])
  revisions       MarkRevision[]

  @@unique([studentId, subjectOfferingId, examType, academicYearId])
  @@index([studentId])
  @@index([subjectOfferingId])
  @@map("marks")
}

/// A record of a mark being corrected by the examination cell.
///
/// A correction overwrites work another person is responsible for, so the
/// value that was replaced is kept here rather than being lost. The teacher
/// whose entry was corrected is named on the row, and the reason the exam
/// cell gave is kept with it — so the question "who changed this score, and
/// why?" always has an answer, years later.
///
/// The row is append-only. Nothing ever updates or deletes it.
model MarkRevision {
  id        String   @id @default(uuid())
  markId    String   @map("mark_id")
  /// The value the mark held before this correction.
  previousMarksObtained Float   @map("previous_marks_obtained")
  previousMaxMarks       Float   @map("previous_max_marks")
  previousIsAbsent       Boolean @map("previous_is_absent")
  previousIsWithheld     Boolean @map("previous_is_withheld")
  previousRemarks        String? @map("previous_remarks")
  /// The value the mark holds after this correction.
  correctedMarksObtained Float   @map("corrected_marks_obtained")
  correctedMaxMarks       Float   @map("corrected_max_marks")
  correctedIsAbsent       Boolean @map("corrected_is_absent")
  correctedIsWithheld     Boolean @map("corrected_is_withheld")
  correctedRemarks        String? @map("corrected_remarks")
  /// The member who made the correction — the examination cell.
  correctedBy         String   @map("corrected_by")
  /// The teacher whose entry was corrected, when there was one.
  overriddenTeacherId String?  @map("overridden_teacher_id")
  overriddenTeacherName String? @map("overridden_teacher_name")
  /// Why the correction was made. Required — a correction is always explained.
  reason              String
  createdAt           DateTime @default(now()) @map("created_at")

  mark Mark @relation(fields: [markId], references: [id], onDelete: Cascade)

  @@index([markId])
  @@index([correctedBy])
  @@index([overriddenTeacherId])
  @@map("mark_revisions")
}

// ============================================================================
// FILE PROCESSING & REPORTS
// ============================================================================

model UploadJob {
  id            String    @id @default(uuid())
  uploadedBy    String    @map("uploaded_by")
  fileName      String    @map("file_name")
  fileType      String    @map("file_type") // EXCEL, PDF_TEXT, PDF_IMAGE
  fileUrl       String    @map("file_url") // Storage URL
  fileSize      Int       @map("file_size")
  status        String    @default("PENDING") // PENDING, PROCESSING, EXTRACTED, FAILED, COMPLETED
  progress      Int       @default(0)
  errorMessage  String?   @map("error_message")
  extractedData Json?     @map("extracted_data")
  metadata      Json?
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  uploadedByUser User @relation(fields: [uploadedBy], references: [id])

  @@index([status, createdAt])
  @@index([uploadedBy])
  @@map("upload_jobs")
}

model Report {
  id           String    @id @default(uuid())
  generatedBy  String    @map("generated_by")
  type         String // STUDENT_WISE, SCHEME_WISE, SUBJECT_ANALYSIS, STUDENT_ANALYSIS, CLASS_TOPPERS, PASS_FAIL, COMPLETE
  filters      Json
  fileUrl      String?   @map("file_url")
  status       String    @default("PENDING")
  errorMessage String?   @map("error_message")
  /// Whether the report is still live.
  ///
  /// A report is never hard-deleted: it is a statement about a class's
  /// results, and a result that existed and then vanished cannot be
  /// accounted for. Deleting archives it — the row stays, the file goes,
  /// and the reason is kept.
  isArchived   Boolean   @default(false) @map("is_archived")
  archivedAt   DateTime? @map("archived_at")
  archivedBy   String?   @map("archived_by")
  /// Why the report was archived.
  archiveReason String?  @map("archive_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  generatedByUser User @relation("ReportGeneratedBy", fields: [generatedBy], references: [id])

  @@index([generatedBy])
  @@index([status])
  @@index([isArchived])
  @@map("reports")
}

// ============================================================================
// AUDIT & NOTIFICATIONS
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String // LOGIN, CREATE_USER, UPDATE_MARKS, etc.
  resource   String // user, marks, scheme
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String // UPLOAD_COMPLETE, REPORT_READY, etc.
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ============================================================================
// INVITES
// ============================================================================

/// Lifecycle of a member invitation.
enum InviteStatus {
  /// Sent, not yet accepted. The only status that can be accepted.
  PENDING
  /// The invitee accepted and an account now exists.
  ACCEPTED
  /// An administrator cancelled the invitation before it was accepted.
  REVOKED
  /// The expiry window elapsed. Flipped lazily when the invite is next read.
  EXPIRED
}

/// An invitation to join the system.
///
/// The user account does not exist until the invitation is accepted, so an
/// unaccepted invitation grants no access at all. Only the SHA-256 hash of the
/// token is stored — a database leak yields no usable invitation links.
model Invite {
  id          String       @id @default(uuid())
  email       String
  name        String
  roleName    String       @map("role_name")
  branchId    String?      @map("branch_id")
  /// SHA-256 of the raw token. The raw token exists only in the email link.
  tokenHash   String       @unique @map("token_hash")
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime     @map("expires_at")
  acceptedAt  DateTime?    @map("accepted_at")
  invitedById String       @map("invited_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  /// Set when a resend replaced this invitation. The link still exists but
  /// it is dead — the newer invitation is the live one. It is kept so the
  /// history stays readable and so a stale link is not mistaken for a live
  /// one.
  supersededById String? @map("superseded_by_id")

  invitedBy    User     @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supersededBy Invite?  @relation("InviteSuperseded", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Invite[] @relation("InviteSuperseded")

  @@index([email])
  @@index([status, expiresAt])
  @@index([invitedById])
  @@index([supersededById])
  @@map("invites")
}
